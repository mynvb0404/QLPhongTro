        }

        // =====================================================================
        // BUTTON: TÌM KIẾM
        // =====================================================================

        private void btnTK_Click(object? sender, EventArgs e)
        {
            // Giới tính tìm kiếm
            string gioiTinh = "";
            if (comboBox4.SelectedIndex > 0) // 0 = "-- Tất cả --"
                gioiTinh = comboBox4.SelectedItem.ToString();

            // Giá chia tối đa
            decimal giaMax = 0;
            if (!string.IsNullOrWhiteSpace(textBox3.Text))
            {
                if (!decimal.TryParse(textBox3.Text.Trim(), out giaMax))
                {
                    MessageBox.Show("Giá chia không hợp lệ!", "Lỗi nhập liệu",
                                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
            }

            // Số người cần (hiện BUS chưa lọc theo số người – bạn có thể mở rộng sau)
            // int soNguoi = (int)numericUpDown3.Value;

            try
            {
                DataTable dt = busTinOGhep.TimKiemTinOGhep(gioiTinh, giaMax, "");
                dataGridView1.DataSource = dt;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi tìm kiếm: " + ex.Message, "Lỗi",
                                MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // =====================================================================
        // DATAGRIDVIEW: CLICK CHỌN HÀNG → ĐỔ DỮ LIỆU LÊN FORM
        // =====================================================================

        private void dataGridView1_CellClick(object? sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            DataGridViewRow row = dataGridView1.Rows[e.RowIndex];

            // Lấy mã tin (cột đầu tiên "Mã tin" hoặc alias "Mã tin")
            if (!int.TryParse(row.Cells[0].Value?.ToString(), out int maTin)) return;
            _maTinDangChon = maTin;

            // --- Đổ dữ liệu lên form ---

            // Phòng
            string tenPhong = row.Cells["Phòng"]?.Value?.ToString() ?? "";
            // Nếu dùng DataSource bind, dùng: cboMaPhong.SelectedValue = maPhongRaw;
            // Tạm thời hiển thị tên:
            int idxPhong = cboMaPhong.FindStringExact(tenPhong);
            if (idxPhong >= 0) cboMaPhong.SelectedIndex = idxPhong;

            // Khách hàng
            string tenKhach = row.Cells["Khách đăng"]?.Value?.ToString() ?? "";
            int idxKH = cboMaKH.FindStringExact(tenKhach);
            if (idxKH >= 0) cboMaKH.SelectedIndex = idxKH;

            // Số người
            if (int.TryParse(row.Cells["Số người"]?.Value?.ToString(), out int soNguoi))
                numericUpDown1.Value = soNguoi;

            // Giới tính
            string gt = row.Cells["Giới tính"]?.Value?.ToString() ?? "Nam";
            int idxGT = cboGioiTinh.FindStringExact(gt);
            if (idxGT >= 0) cboGioiTinh.SelectedIndex = idxGT;

            // Giá chia
            txtGiaChia.Text = row.Cells["Giá chia"]?.Value?.ToString() ?? "";

            // Mô tả (cột ẩn)
            if (dataGridView1.Columns.Contains("MoTa"))
                txtMoTa.Text = row.Cells["MoTa"]?.Value?.ToString() ?? "";

            // Trạng thái
            string tt = row.Cells["Trạng thái"]?.Value?.ToString() ?? "Đang tìm";
            int idxTT = cboTrangThai.FindStringExact(tt);
            if (idxTT >= 0) cboTrangThai.SelectedIndex = idxTT;
        }

