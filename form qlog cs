        /// <summary>
        /// Đọc dữ liệu từ các control trên form và trả về DTO_TINOGHEP.
        /// Trả về null nếu dữ liệu nhập không hợp lệ cơ bản.
        /// </summary>
        private DTO_TINOGHEP DocDuLieuTuForm()
        {
            // --- Mã phòng ---
            int maPhong = 0;
            // Nếu dùng DataSource (ValueMember):
            // maPhong = (cboMaPhong.SelectedValue != null) ? (int)cboMaPhong.SelectedValue : 0;
            // Nếu dùng Items thủ công, bạn cần tự lấy ID – hiện để 0 làm placeholder:
            if (cboMaPhong.SelectedIndex <= 0)
            {
                MessageBox.Show("Vui lòng chọn phòng!", "Thiếu thông tin",
                                MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return null;
            }
            // TODO: lấy maPhong từ ValueMember khi bạn bind DataSource thật
            // maPhong = (int)cboMaPhong.SelectedValue;

            // --- Mã khách hàng ---
            int maKH = 0;
            if (cboMaKH.SelectedIndex <= 0)
            {
                MessageBox.Show("Vui lòng chọn khách hàng!", "Thiếu thông tin",
                                MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return null;
            }
            // TODO: maKH = (int)cboMaKH.SelectedValue;

            // --- Số người cần ---
            int soNguoi = (int)numericUpDown1.Value;

            // --- Giới tính ---
            GioiTinh gt = (cboGioiTinh.SelectedItem?.ToString() == "Nam")
                          ? GioiTinh.Nam
                          : GioiTinh.Nu;

            // --- Giá chia ---
            if (!decimal.TryParse(txtGiaChia.Text.Trim(), out decimal giaChia))
            {
                MessageBox.Show("Giá chia không hợp lệ! Vui lòng nhập số.", "Lỗi nhập liệu",
                                MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return null;
            }

            // --- Mô tả ---
            string moTa = txtMoTa.Text.Trim();

            // --- Trạng thái ---
            TrangThaiTinOGhep tt = ChuyenDoiTrangThai(cboTrangThai.SelectedItem?.ToString());

            return new DTO_TINOGHEP(
                matinog: _maTinDangChon > 0 ? _maTinDangChon : 0,
                maphong: maPhong,
                makh: maKH,
                songuoican: soNguoi,
                gioitinh: gt,
                giachia: giaChia,
                mota: moTa,
                trangthaitin: tt
            );
        }

        // =====================================================================
        // HELPER: CHUYỂN ĐỔI TRẠNG THÁI
        // =====================================================================

        private TrangThaiTinOGhep ChuyenDoiTrangThai(string str)
        {
            return str switch
            {
                "Đã đủ người" => TrangThaiTinOGhep.DaDuNguoi,
                "Đã đóng" => TrangThaiTinOGhep.DaDong,
                _ => TrangThaiTinOGhep.DangTim
            };
        }

